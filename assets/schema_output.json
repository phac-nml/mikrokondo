{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/mikrokondo/main/assets/schema_output.json",
    "title": "Mikrokondo Output Schema",
    "description": "The Mikrokondo-specific schema used for validating IRIDA Next JSON output data",
    "type": "object",
    "properties": {
        "files": {
            "type": "object",
            "properties": {
                "global": {
                    "type": "array",
                    "items": {
                        "properties": {
                            "path": {
                                "anyOf": [
                                    {
                                        "pattern": "^.*FinalReports/.*Aggregated/.*Json/.*final_report.json$",
                                        "description": "All tool results for all samples in JSON format."
                                    },
                                    {
                                        "pattern": "^.*FinalReports/.*Aggregated/.*Tables/.*final_report.tsv$",
                                        "description": "All tool results for all samples in TSV format."
                                    },
                                    {
                                        "pattern": "^.*error/.*max_samples_exceeded.error.txt$",
                                        "description": "A file containing an error message reporting that more samples have been provided than the max_samples parameter allows."
                                    }
                                ]
                            }
                        },
                        "additionalProperties": false
                    },
                    "uniqueItems": true
                },
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "array",
                            "items": {
                                "properties": {
                                    "path": {
                                        "anyOf": [
                                            {
                                                "pattern": "^.*Assembly/.*FinalAssembly/.*/.*.filtered.assembly.fasta.gz$",
                                                "description": "The final output contig files from the last step in the assembly process."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Quality/.*QUAST/.*/.*.transposed.*.quast.quality.tsv$",
                                                "description": "TSV-formmated file containing transposed QUAST assembly quality metrics."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Quality/.*CheckM2/.*/.*.quality_report.checkm2.quality.tsv$",
                                                "description": "CheckM2 report containing the completeness and contamination information."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Quality/.*SeqKitStats/.*.seqkit.stats.summary.tsv$",
                                                "description": "SeqKit summary statistics of assembly files."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*PostProcessing/.*Speciation/.*MashScreen/.*.taxa.screen.screen$",
                                                "description": "Mash screen results estimating species containment of provided sequences."
                                            },
                                            {
                                                "pattern": "^.*Reads/.*Quality/.*Trimmed/.*MashScreen/.*.reads.screen.screen$",
                                                "description": "Mash screen results estimating metagenomic containment of provided sequences."
                                            },
                                            {
                                                "pattern": "^.*Reads/.*Quality/.*Trimmed/.*FastP/.*.fastp.summary.json$",
                                                "description": "JSON-formatted fastp summary results for FASTQ-formatted sequences."
                                            },
                                            {
                                                "pattern": "^.*Reads/.*Quality/.*RawReadQuality/.*.scan.summary.json$",
                                                "description": "Mikrokondo-specific FASTQ summary stats."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*ECTyper/.*/.*.blastn_output_alleles.ectyper.subtyping.txt$",
                                                "description": "ECTyper BLASTN hits of the O and H antigen database."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*ECTyper/.*/.*.ectyper.subtyping.log$",
                                                "description": "ECTyper log messages."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*ECTyper/.*/.*.output.ectyper.subtyping.tsv$",
                                                "description": "ECTyper serotyping results."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*Lissero/.*.lissero.subtyping.tsv$",
                                                "description": "LisSero serogroup predictions for Listeria monocytogenes."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*SISTR/.*.sistr.subtyping.tab$",
                                                "description": "SISTR Salmonella serovar prediction primary results."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*SISTR/.*.sistr.allele.subtyping.fasta$",
                                                "description": "SISTR Salmonella serovar prediction novel cgMLST alleles from input genomes."
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*SISTR/.*.sistr.allele.subtyping.json$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*SISTR/.*.sistr.cgmlst.subtyping.csv$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*Locidex/.*Report/.*.mlst.subtyping.json.gz$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Subtyping/.*Locidex/.*Summary/.*.locidex.summary.json$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*FinalReports/.*FlattenedReports/.*.flat_sample.json.gz$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Annotation/.*Abricate/.*abricate.annotation.txt$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Annotation/.*Mobsuite/.*Recon/.*/.*mobtyper_results.*.txt$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Annotation/.*Bakta/.*.gbff$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Annotation/.*Bakta/.*.txt$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Annotation/.*StarAMR/.*/.*summary.*.tsv$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Annotation/.*StarAMR/.*/.*detailed_summary.*.tsv$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*Assembly/.*Annotation/.*StarAMR/.*/.*results.*.xlsx$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*pipeline_info/.*.mikrokondo.parameters.json$",
                                                "description": ""
                                            },
                                            {
                                                "pattern": "^.*pipeline_info/.*.mikrokondo.software.version.yml$",
                                                "description": ""
                                            }
                                        ]
                                    }
                                },
                                "additionalProperties": false
                            },
                            "uniqueItems": true
                        }
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "properties": {
                "samples": {
                    "type": "object",
