iridanext {
    enabled = true
    output {
        path = "${params.outdir}/iridanext.output.json.gz"
        overwrite = true
        files {
            idkey = 'external_id'  // Previously sample
            global = [
                "**/FinalReports/Aggregated/Tables/final_report_transposed.tsv"
            ]
            samples = [

            ]
        }
        metadata {
            samples {
                flatten = true
                rename = [

                ]
                keep = [

                ]
                json {
                    path = "**/FinalReports/Sample/Json/final_report_flattened.json"
                }
            }
        }
    }
}
